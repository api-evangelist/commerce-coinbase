                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"examples\": {\n    \"request\": {\n      \"description\": \"JSON-RPC Request Example\",\n      \"value\": {\n        \"id\": 7859,\n        \"jsonrpc\": \"2.0\",\n        \"method\": \"private/enable_cancel_on_disconnect\",\n        \"params\": {\n          \"scope\": \"account\"\n        }\n      }\n    }\n  }\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/private/enable_cancel_on_disconnect?scope=account",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "private",
                    "enable_cancel_on_disconnect"
                  ],
                  "query": [
                    {
                      "description": "Specifies if Cancel On Disconnect change should be applied/checked for the current connection or the account (default - `connection`)<br/><br/> **NOTICE:** Scope `connection` can be used only when working via Websocket.",
                      "key": "scope",
                      "value": "account"
                    }
                  ]
                },
                "description": "Enable Cancel On Disconnect for the connection. After enabling, all orders created via this connection will be automatically cancelled when the connection is closed.\n\nCancel is triggered in the following cases: when the TCP connection is properly terminated, when the connection is closed due to 10 minutes of inactivity, or when a heartbeat detects a disconnection. To reduce the inactivity timeout, consider using public/set_heartbeat.\n\n**Note:** If the connection is gracefully closed using private/logout, cancel-on-disconnect will **not** be triggered.\n\n**Notice:** Cancel-on-Disconnect does not affect orders created by other connections - they will remain active! When change is applied on the `account` scope, then every newly opened connection will start with **active** Cancel on Disconnect.\n\n**WebSocket Only:** This method is designed exclusively for WebSocket connections. Attempting to use it via REST/HTTP will result in an error response.\n\nTry in API console"
              },
              "response": [
                {
                  "id": "685e46b2-545d-4429-bfdb-01d2e42679a5",
                  "name": "Success response",
