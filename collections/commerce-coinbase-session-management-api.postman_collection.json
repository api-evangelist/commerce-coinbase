            {
              "name": "Get private enable cancel on disconnect",
              "id": "f3af76e0-ae4f-4308-89b4-c65e4d76f900",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
