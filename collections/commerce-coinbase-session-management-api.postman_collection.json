                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"examples\": {\n    \"request\": {\n      \"description\": \"JSON-RPC Request Example\",\n      \"value\": {\n        \"id\": 1569,\n        \"jsonrpc\": \"2.0\",\n        \"method\": \"private/disable_cancel_on_disconnect\",\n        \"params\": {\n          \"scope\": \"account\"\n        }\n      }\n    }\n  }\n}",
