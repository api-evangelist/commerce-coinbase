                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"examples\": {\n    \"request\": {\n      \"description\": \"JSON-RPC Request Example\",\n      \"value\": {\n        \"id\": 210,\n        \"jsonrpc\": \"2.0\",\n        \"method\": \"private/submit_transfer_between_subaccounts\",\n        \"params\": {\n          \"amount\": 12.1234,\n          \"currency\": \"ETH\",\n          \"destination\": 20,\n          \"source\": 10\n        }\n      }\n    }\n  }\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/private/submit_transfer_between_subaccounts?currency=USDC&amount=<number>&destination=<integer>&source=<integer>&nonce=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "private",
                    "submit_transfer_between_subaccounts"
                  ],
                  "query": [
                    {
                      "description": "(Required) The currency symbol",
                      "key": "currency",
                      "value": "USDC"
                    },
                    {
                      "description": "(Required) Amount of funds to be transferred",
                      "key": "amount",
                      "value": "<number>"
                    },
                    {
                      "description": "(Required) Id of destination subaccount. Can be found in `My Account >> Subaccounts` tab",
                      "key": "destination",
                      "value": "<integer>"
                    },
                    {
                      "description": "Id of the source (sub)account. Can be found in `My Account >> Subaccounts` tab. By default, it is the Id of the account which made the request. However, if a different \"source\" is specified, the user must possess the mainaccount scope, and only other subaccounts can be designated as the source.",
                      "key": "source",
                      "value": "<integer>"
                    },
                    {
                      "description": "Optional idempotency nonce. If provided, subsequent requests with the same nonce will return the previously created transaction instead of creating a new one. Must be 8-128 characters. The nonce is persisted on the resulting transaction and returned in the response.",
                      "key": "nonce",
                      "value": "<string>"
                    }
                  ]
                },
                "description": "Transfer funds between two subaccounts or between a subaccount and the main account.\n\n**\ud83d\udcd6 Related Article:** Managing Transfers\n\nTry in API console"
