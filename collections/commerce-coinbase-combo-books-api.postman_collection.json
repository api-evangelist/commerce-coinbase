                  "raw": "{\n  \"examples\": {\n    \"request\": {\n      \"description\": \"JSON-RPC Request Example\",\n      \"value\": {\n        \"id\": 1,\n        \"jsonrpc\": \"2.0\",\n        \"method\": \"private/get_leg_prices\",\n        \"params\": {\n          \"legs\": [\n            {\n              \"amount\": 2,\n              \"direction\": \"buy\",\n              \"instrument_name\": \"BTC-1NOV24-67000-C\"\n            },\n            {\n              \"amount\": 2,\n              \"direction\": \"sell\",\n              \"instrument_name\": \"BTC-1NOV24-66000-C\"\n            }\n          ],\n          \"price\": 0.6\n        }\n      }\n    }\n  }\n}",
